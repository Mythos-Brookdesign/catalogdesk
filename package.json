{
  "name": "catalogdesk",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first product data validation and WooCommerce CSV preparation",
  "author": "Marco Hinkelmann",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "dev:electron": "wait-on http://127.0.0.1:5178 && electron . --dev",
    "start": "electron .",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && node --check electron/main.cjs && node --check electron/preload.cjs",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "preview": "vite preview --host 127.0.0.1 --port 5178"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.55.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  }
}
